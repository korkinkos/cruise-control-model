Kp_range = [25 50 75 100 125 150];
Ki_range = [0.0, 10.0];
Kd_range = [0.0];

% results = struct([]);

id = 1;
for i = 1:length(Kp_range)
    for j = 1:length(Ki_range)
        for k = 1:length(Kd_range)
            Kp = Kp_range(i);
            Ki = Ki_range(j);
            Kd = Kd_range(k);

            result = analyze_results(Kp, Ki, Kd);
        
            result.Kp = Kp;
            result.Ki = Ki;
            result.Kd = Kd;
            
            if id == 1
                results = result;
            else
                results(id) = result;
            end

            id += 1;
        end
    end
end